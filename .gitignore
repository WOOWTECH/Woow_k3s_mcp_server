# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# Node
node_modules/
package-lock.json

# Environment & Secrets
.env
.env.local
.env.*
*.env
cf-config.json
# Real secrets must never be committed - only examples/secrets.example.yaml.
# Anchored to the repo root (leading /) on purpose: an unanchored "secrets.yaml"
# would also match templates/secrets.yaml and keep the chart's own Secret
# template out of git.
/secrets.yaml
/*-secrets.yaml
/*.secret.yaml
/*secrets.values.yaml
/*.local.yaml
!/templates/secrets.yaml

# Test artifacts
test-results/
playwright-report/
# Anchored to the report directories on purpose. A bare `*.html` is unanchored
# and matched k3s-mcp-admin/frontend/index.html - Vite's entry point - so the
# frontend could never build from a fresh clone and the image could not be
# rebuilt at all. (Same class as the `!/templates/secrets.yaml` exception above.)
/test-results/**/*.html
/playwright-report/**/*.html

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.tar
*.gz

# Helm dependency cache - run `helm dependency build` to (re)fetch.
# Chart.lock IS committed for reproducibility.
/charts/*.tgz
