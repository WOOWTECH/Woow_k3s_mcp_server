#!/usr/bin/env bash
NAMESPACE="mcp-system"
MCP_POD_LABEL="app.kubernetes.io/name=kubernetes-mcp-server"
PROXY_POD_LABEL="app.kubernetes.io/name=mcp-k8s-proxy"
MCP_SVC="kubernetes-mcp-server"
PROXY_SVC="mcp-k8s-proxy-svc"
MCP_PORT=8080
PROXY_PORT=8001
TOKEN="${MCP_TOKEN:-YOUR_TOKEN_HERE}"   # Set via: export MCP_TOKEN=your_token
TOKEN_PATH="/private_${TOKEN}"
EXTERNAL_URL="https://${MCP_HOSTNAME:-your-k8s-mcp.example.com}/private_${TOKEN}"

# Resolve ClusterIPs for direct access
MCP_CLUSTER_IP=$(kubectl -n "$NAMESPACE" get svc "$MCP_SVC" -o jsonpath='{.spec.clusterIP}' 2>/dev/null)
PROXY_CLUSTER_IP=$(kubectl -n "$NAMESPACE" get svc "$PROXY_SVC" -o jsonpath='{.spec.clusterIP}' 2>/dev/null)
MCP_DIRECT_URL="http://${MCP_CLUSTER_IP}:${MCP_PORT}"
PROXY_URL="http://${PROXY_CLUSTER_IP}:${PROXY_PORT}"
